pipeline {
    agent any
    environment {
        name = "srijayanu/train"
        max = 50
        random_num = "${Math.abs(new Random().nextInt(max+1))}"
        image_name = "${name}${random_num}"
    }
    stages {
         stage("Git Checkout") {
            steps {
              script {
                checkout scmGit(branches: [[name: '*/dependabot/npm_and_yarn/npm-6.14.6']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/SrijayAnu/bhavukm-cicd-pipeline-train-schedule-autodeploy.git']])
                 stash includes: 'train1.yml, train-shedule.yml', name: 'mystash' 
                 }
             }
         }
        stage("Gradle Build") {
            steps {
                echo 'Running build automation'
                sh './gradlew build --info --no-daemon'
                archiveArtifacts artifacts: 'dist/trainSchedule.zip'
            }
        }
        stage("docker image")
        {
            steps {
                sh 'docker build -t $image_name .'
            }
        }
        stage("docker login and push")
        {
           steps {
              withCredentials([string(credentialsId: 'dockerloginpwd', variable: 'dockerlogin')]) { 
             sh 'echo ${dockerlogin} | docker login -u srijayanu --password-stdin'
             sh 'docker push $image_name '
                }
            }
        }
        stage ("Deployment")
        {
        agent { 
            label "worker" 
             }
         steps {
          unstash 'mystash'
          sh '''
          sudo -i kubectl get nodes 
          sudo -i kubectl get cs
          awk '{gsub(/image_name/, ENVIRON["image_name"])}1' train1.yml > temp_file.yml && mv temp_file.yml train1.yml
          awk '{gsub(/image_name/, ENVIRON["image_name"])}1' train-shedule.yml > temp_file.yml && mv temp_file.yml train-shedule.yml
          sudo -i kubectl apply -f /tmp/workspace/pipeline1/train1.yml
          sudo -i kubectl apply -f /tmp/workspace/pipeline1/train-shedule.yml
          sleep 180
          sudo -i kubectl get all
          '''
        }
     }
  }
}
